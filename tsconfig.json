{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "legacy",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
